3ctext x=\"1536\" y=\"4250\" font-size=\"91.000\" font-weight=\"400\" stroke-width=\"7\" letter-spacing=\"1\">RARA\u003c/text>\u003ctext x=\"1045\" y=\"3202\" font-size=\"85.000\" font-weight=\"400\" stroke-width=\"7\" letter-spacing=\"4\">ELEMENTO\u003c/text>\u003ctext x=\"1158\" y=\"3355\" font-size=\"80.000\" font-weight=\"600\" stroke-width=\"9\" letter-spacing=\"1\">FULMINE\u003c/text>\u003ctext x=\"2024\" y=\"3202\" font-size=\"88.000\" font-weight=\"400\" stroke-width=\"7\" letter-spacing=\"4\">DURATA\u003c/text>\u003ctext x=\"1930\" y=\"3355\" font-size=\"152.000\" font-weight=\"600\" stroke-width=\"12\" letter-spacing=\"1\">1\u003c/text>\u003ctext x=\"2220\" y=\"3355\" font-size=\"104.000\" font-weight=\"600\" stroke-width=\"9\" letter-spacing=\"1\">TURNO\u003c/text>\u003ctext x=\"1042\" y=\"3547\" font-size=\"78.000\" font-weight=\"400\" stroke-width=\"7\" letter-spacing=\"4\">DANNO BASE\u003c/text>\u003ctext x=\"1165\" y=\"3700\" font-size=\"138.000\" font-weight=\"600\" stroke-width=\"12\" letter-spacing=\"1\">28 HP\u003c/text>\u003ctext x=\"2056\" y=\"3547\" font-size=\"68.000\" font-weight=\"400\" stroke-width=\"7\" letter-spacing=\"4\">COMBO CON SONDA\u003c/text>\u003ctext x=\"2056\" y=\"3620\" font-size=\"68.000\" font-weight=\"600\" stroke-width=\"9\" letter-spacing=\"1\">SECONDO COLPO 18 HP\u003c/text>\u003ctext x=\"2056\" y=\"3692\" font-size=\"68.000\" font-weight=\"600\" stroke-width=\"9\" letter-spacing=\"1\">CONSUMA SEGNALE\u003c/text>\u003ctext x=\"2056\" y=\"3764\" font-size=\"68.000\" font-weight=\"600\" stroke-width=\"9\" letter-spacing=\"1\">SE BERSAGLIO VIVO\u003c/text>\u003ctext x=\"1138\" y=\"3933\" font-size=\"93.375\" font-weight=\"600\" stroke-width=\"9\" letter-spacing=\"1\">1 BERSAGLIO\u003c/text>\u003ctext x=\"2160\" y=\"3933\" font-size=\"95.000\" font-weight=\"600\" stroke-width=\"9\" letter-spacing=\"1\">1 O 2 COLPI\u003c/text>\u003c/g>\u003c/g>\u003c/svg>"}},{"id":"weapon-designed-ionic-sonda-ionica-rarity-r","names":{"en":"I