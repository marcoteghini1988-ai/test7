ona da solo senza segnale. Difese e copertura si applicano a ogni impatto."},"text":{"en":"\u003csvg xmlns=\"http://www.w3.org/2000/svg\" width=\"3072\" height=\"4608\" viewBox=\"0 0 3072 4608\">\u003cdefs>\u003clinearGradient id=\"weapon-designed-ionic-martello-tuono-rarity-e-en-material\" x1=\"0\" y1=\"0\" x2=\".35\" y2=\"1\">\u003cstop stop-color=\"#ffffff\"/>\u003cstop offset=\".52\" stop-color=\"#8799a9\"/>\u003cstop offset=\"1\" stop-color=\"#e4edf4\"/>\u003c/linearGradient>\u003cfilter id=\"weapon-designed-ionic-martello-tuono-rarity-e-en-shadow\">\u003cfeDropShadow dx=\"0\" dy=\"5\" stdDeviation=\"6\" flood-color=\"#070e17\" flood-opacity=\".85\"/>\u003c/filter>\u003cclipPath id=\"weapon-designed-ionic-martello-tuono-rarity-e-en-clip\">\u003crect x=\"680\" y=\"350\" width=\"1710\" height=\"210\"/>\u003crect x=\"1090\" y=\"2855\" width=\"892\" height=\"140\"/>\u003crect x=\"440\" y=\"3140\" width=\"2195\" height=\"930\"/>\u003crect x=\"1110\" y=\"4180\" width=\"852\" height=\"140\"/>\u003c/clipPath>\u003c/defs>\u003cg clip-path=\"url(#weapon-designed-ionic-martello-tuono-rarity-e-en-clip)\">\u003cg filter=\"url(#weapon-designed-ionic-martello-tuono-rarity-e-en-shadow)\" fill=\"url(#weapon-designed-ionic-martello-tuono-rarity-e-en-material)\" stroke=\"#121a23\" paint-order=\"stroke fill\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-family=\"Eclissi Vettore, sans-serif\">\u003ctext x=\"1536\" y=\"416\" font-size=\"102.000\" font-weight=\"400\" stroke-width=\"7\" letter-spacing=\"1\">THUNDER\u003c/text>\u003ctext x=\"1536\" y=\"502\" font-size=\"105.000\" font-weight=\"400\" stroke-width=\"7\" letter-spacing=\"1\">HAMMER\u003c/text>\u003ctext x=\"1536\" y=\"2925\" font-size=\"91.000\" font-weight=\"400\" stroke-width=\"7\" letter-spacing=\"1\">WEAPON\u003c/text>\u003ctext x=\"1536\" y=\"4250\" font-size=\"91.000\" font-weight=\"400\" stroke-width=\"7\" letter-spacing=\"1\">EPIC\u003c/text>\u003ctext x=\"1045\" y=\"3202\" font-size=\"85.000\" font-we