ight=\"400\" stroke-width=\"7\" letter-spacing=\"1\">D'ASSALTO\u003c/text>\u003ctext x=\"1536\" y=\"2925\" font-size=\"91.000\" font-weight=\"400\" stroke-width=\"7\" letter-spacing=\"1\">ARMA\u003c/text>\u003ctext x=\"1536\" y=\"4250\" font-size=\"91.000\" font-weight=\"400\" stroke-width=\"7\" letter-spacing=\"1\">COMUNE\u003c/text>\u003ctext x=\"1045\" y=\"3202\" font-size=\"85.000\" font-weight=\"400\" stroke-width=\"7\" letter-spacing=\"4\">ELEMENTO\u003c/text>\u003ctext x=\"1158\" y=\"3355\" font-size=\"80.000\" font-weight=\"600\" stroke-width=\"9\" letter-spacing=\"1\">FULMINE\u003c/text>\u003ctext x=\"2024\" y=\"3202\" font-size=\"88.000\" font-weight=\"400\" stroke-width=\"7\" letter-spacing=\"4\">DURATA\u003c/text>\u003ctext x=\"1930\" y=\"3355\" font-size=\"152.000\" font-weight=\"600\" stroke-width=\"12\" letter-spacing=\"1\">1\u003c/text>\u003ctext x=\"2220\" y=\"3355\" font-size=\"104.000\" font-weight=\"600\" stroke-width=\"9\" letter-spacing=\"1\">TURNO\u003c/text>\u003ctext x=\"1042\" y=\"3547\" font-size=\"78.000\" font-weight=\"400\" stroke-width=\"7\" letter-spacing=\"4\">DANNO BASE\u003c/text>\u003ctext x=\"1165\" y=\"3700\" font-size=\"138.000\" font-weight=\"600\" stroke-width=\"12\" letter-spacing=\"1\">8 HP\u003c/text>\u003ctext x=\"2056\" y=\"3547\" font-size=\"68.000\" font-weight=\"400\" stroke-width=\"7\" letter-spacing=\"4\">SEGNA SE DANNEGGIA\u003c/text>\u003ctext x=\"2056\" y=\"3620\" font-size=\"68.000\" font-weight=\"600\" stroke-width=\"9\" letter-spacing=\"1\">PROSSIMO MARTELLO\u003c/text>\u003ctext x=\"2056\" y=\"3692\" font-size=\"68.000\" font-weight=\"600\" stroke-width=\"9\" letter-spacing=\"1\">QUESTO O PROSSIMO\u003c/text>\u003ctext x=\"2056\" y=\"3764\" font-size=\"68.000\" font-weight=\"600\" stroke-width=\"9\" letter-spacing=\"1\">TURNO PROPRIO\u003c/text>\u003ctext x=\"1138\" y=\"3933\" font-size=\"93.375\" font-weight=\"600\" stroke-width=\"9\" letter-spacing=\"1\">1 BERSAGLIO\u003c/text>\u003ctext x=\"2160\" y=\"3933\" font-size=\"95.000\" font-weight=\"600\" stroke-width=\"9\" letter-spacing=\"1\">1 COLPO\u003c/text>\u003c/g>\u003c/g>\u003c/svg>"}},{"id":"weapon-designed-ionic-martello-tuono","names":{"en":"Thunder Hammer","it":"Martello del Tuono"},"descriptions":{"en":"Deals 28 HP with one hit. A valid Ionic Assault Probe mark adds a separate 18 HP hit on that target if it remains alive, consuming the mark. Works independently without a mark. Normal defenses and cover apply to each hit.","it":"Infligge 28 HP con un colpo. Un segnale valido della Sonda aggiunge un secondo impatto distinto da 18 HP sul bersaglio ancora vivo e viene consumato. Funziona da solo senza segnale. Difese e copertura si applicano a ogni impatto."},"text":{"en":"\u003csvg xmlns=\"http://www.w3.org/2000/svg\" width=\"3072\" height=\"4608\" viewBox=\"0 0 3072 4608\">\u003cdefs>\u003clinearGradient id=\"weapon-designed-ionic-martello-tuono-en-material\" x1=\"0\" y1=\"0\" x2=\".35\" y2=\"1\">\u003cstop stop-color=\"#fff0d6\"/>\u003cstop offset=\".52\" stop-color=\"#d38c5b\"/>\u003cstop offset=\"1\" stop-color=\"#f3c393\"/>\u003c/linearGradient>\u003cfilter id=\"weapon-designed-ionic-martello-tuono-en-shadow\">\u003cfeDropShadow dx=\"0\" dy=\"5\" stdDeviation=\"6\" flood-color=\"#070e17\" flood-opacity=\".85\"/>\u003c/filter>\u003cclipPath id=\"weapon-designed-ionic-martello-tuono-en-clip\">\u003crect x=\"680\" y=\"350\" width=\"1710\" height=\"210\"/>\u003crect x=\"1090\" y=\"2855\" width=\"892\" height=\"140\"/>\u003crect x=\"440\" y=\"3140\" width=\"2195\" height=\"930\"/>\u003crect x=\"1110\" y=\"4180\" width=\"852\" height=\"140\"/>\u003c/clipPath>\u003c/defs>\u003cg clip-path=\"url(#weapon-designed-ionic-martello-tuono-en-clip)\">\u003cg filter=\"url(#weapon-designed-ionic-martello-tuono-en-shadow)\" fill=\"url(#weapon-designed-ionic-martello-tuono-en-material)\" stroke=\"#121a23\" paint-order=\"stroke fill\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-family=\"Eclissi Vettore, sans-serif